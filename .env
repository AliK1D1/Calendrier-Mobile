# Freecrew mobile : configuration publique, commitée exprès pour que l'app marche après
# `npm install` sans rien créer. Expo lit ce fichier tout seul ; un `.env.local` (jamais
# commité) peut remplacer ces valeurs, par exemple pour un projet Supabase de test.
#
# Ce sont les mêmes valeurs que NEXT_PUBLIC_SUPABASE_URL et NEXT_PUBLIC_SUPABASE_ANON_KEY du
# site. La clé « publishable » (anon) est publique : c'est la RLS qui protège les données.
# JAMAIS la clé service_role (ou « secret ») ici.
EXPO_PUBLIC_SUPABASE_URL=https://wfjwxwhrqhjeagbwmneu.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_CHBZ0clpUf-SE83Mtsam_w_mPCNxICj

# Adresse du site (liens « Ouvrir sur le site », invitations).
EXPO_PUBLIC_SITE_URL=https://calendrier-opal.vercel.app
